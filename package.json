{
  "name": "nyatinorma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension and launcher for a local Ollama visual computer-use agent",
  "scripts": {
    "start": "tsx src/cli.ts tui",
    "doctor": "tsx src/cli.ts doctor",
    "permissions": "tsx src/cli.ts permissions",
    "bridge:restart": "tsx src/cli.ts bridge-restart",
    "observe": "tsx src/cli.ts observe",
    "probe": "tsx src/cli.ts probe",
    "probe:background": "tsx scripts/background-probe.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:native": "sh scripts/build-native.sh",
    "licenses:report": "tsx scripts/license-report.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "sharp": "0.35.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "extensions/",
    "resources/",
    "native/",
    "scripts/",
    "docs/",
    "README.md",
    "nyatinorma.example.json",
    "nyatinorma.command",
    "nyatinorma-permissions.command",
    "nyatinorma.cmd",
    "tsconfig.json",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD-PARTY-NOTICES.md",
    "licenses/"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyabia/nyatinorma.git"
  },
  "bugs": {
    "url": "https://github.com/nyabia/nyatinorma/issues"
  },
  "homepage": "https://github.com/nyabia/nyatinorma#readme"
}
