{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "extensions/**/*.ts", "scripts/**/*.ts"]
}
